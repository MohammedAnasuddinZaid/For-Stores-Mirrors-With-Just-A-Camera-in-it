# ============================================================
# Virtual Try-On Platform - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your setup

# --- Application ---
APPLICATION_ENV=development
APP_NAME=VirtualTryOn
DEBUG=true
LOG_LEVEL=DEBUG

# --- Storage (D: drive for large data) ---
DATA_ROOT=D:\VirtualTryOn
MODEL_DIR=${DATA_ROOT}\models
MODEL_CACHE_DIR=${DATA_ROOT}\model_cache
GARMENT_ASSET_DIR=${DATA_ROOT}\garment_assets
UPLOAD_DIR=${DATA_ROOT}\user_uploads
RESULT_DIR=${DATA_ROOT}\generated_results
TEMP_DIR=${DATA_ROOT}\temporary
LOG_DIR=${DATA_ROOT}\logs

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=standard

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ---
# Uses SQLite for development (no external DB needed)
DATABASE_URL=sqlite:///./data/app.db

# --- AI/Model Configuration ---
AI_ENGINE=mock
AI_MODEL=ootdiffusion
AI_DEVICE=cpu
AI_RUNTIME=auto

# --- Hugging Face (Free Tier - Optional) ---
HUGGINGFACE_TOKEN=
HUGGINGFACE_SPACE=levihsu/OOTDiffusion

# --- Replicate (Free Trial - Optional) ---
REPLICATE_API_TOKEN=

# --- Storage Provider ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=${DATA_ROOT}\garment_assets

# --- Queue ---
QUEUE_PROVIDER=local
REDIS_URL=

# --- Session ---
SESSION_EXPIRY_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=60

# --- Upload ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Try-On ---
MAX_TRY_ON_RETRIES=3
TRY_ON_TIMEOUT_SECONDS=120
